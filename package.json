{
  "name": "aegiscare-360",
  "private": true,
  "type": "module",
  "description": "AegisCare 360 — multi-agent family defense network (Amazon Developer Hackathon)",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "services/*",
    "infra"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
