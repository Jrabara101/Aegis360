    "mcp:dev": "tsx services/mcp-server/src/local.ts",
    "synth": "npm run synth -w infra"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
